# Server Environment Variables
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/hockeyhub
JWT_SECRET=hockeyhub_super_secret_key_change_me
JWT_EXPIRES_IN=7d

# CORS — Frontend URL(s) allowed to call this API
# Comma-separated for multiple origins
# e.g. https://hockey-website.vercel.app,https://www.hockeyhub.com
FRONTEND_URL=http://localhost:5173

# Email (Nodemailer - Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=HockeyHub <noreply@hockeyhub.com>

# Contact form — Where to receive messages from website visitors
# Falls back to EMAIL_USER if not set
CONTACT_RECEIVER_EMAIL=your_personal_email@gmail.com

# Admin seed
ADMIN_EMAIL=admin@hockeyhub.com
ADMIN_PASSWORD=admin123

